# ==============================================================================
# VECIRED IA — VARIABLES DE ENTORNO COMPARTIDAS
# ==============================================================================
ENVIRONMENT=development
DEBUG=True

PROJECT_NAME="VeciRed IA Backend"
VERSION=1.0.0
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Supabase Auth
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key

# PostgreSQL Supabase Cloud Pooler (Base de datos compartida para todo el equipo)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# ANTHROPIC CLAUDE VISION (EXTRACCIÓN OCR DNI INTELIGENTE)
# ==============================================================================
# Clave de API de Anthropic para extracción y validación de DNI peruano con Claude Vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
