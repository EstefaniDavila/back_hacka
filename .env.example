# ==============================================================================
# VECIRED IA — VARIABLES DE ENTORNO (FASE 1: BASE DEL BACKEND)
# ==============================================================================

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development
DEBUG=True

# Configuración del Servidor y API
PROJECT_NAME="VeciRed IA Backend"
VERSION=1.0.0
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS: Lista de orígenes permitidos (JSON string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","*"]

# ==============================================================================
# CONEXIÓN A POSTGRESQL (SUPABASE)
# ==============================================================================
# En Supabase puedes conectar de dos formas principales:
#
# 1. MODO POOLER (Recomendado para producción / serverless / alta concurrencia):
#    - Transaction Pooler (Puerto 6543): Ideal para consultas rápidas transaccionales.
#      Formato: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/[DB_NAME]
#    - Session Pooler (Puerto 5432): Si se requiere estado de sesión.
#      Formato: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/[DB_NAME]
#
# 2. CONEXIÓN DIRECTA (Puerto 5432):
#    - Conexión directa a la instancia de Postgres sin intermediarios PgBouncer.
#      Formato: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/[DB_NAME]
#
# NOTA TÉCNICA: asyncpg requiere statement_cache_size=0 al conectarse a PgBouncer / Transaction Pooler.
# Esto ya está manejado automáticamente en el pool de conexiones de la aplicación.
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD_AQUI@db.TU_PROYECTO.supabase.co:5432/postgres

# Parámetros del Pool de Conexiones SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# ANTHROPIC CLAUDE VISION (EXTRACCIÓN OCR DNI INTELIGENTE)
# ==============================================================================
# Clave de API de Anthropic para extracción y validación de DNI peruano con Claude Vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
